{
  "name": "dsh-nutstore-backup",
  "version": "0.1.0",
  "description": "坚果云（Nutstore WebDAV）备份插件：在 DSH 设置里登录坚果云，增量备份会话记录、插件配置与工作区记忆，并在新机器上一键恢复。",
  "type": "module",
  "main": "lib/index.mjs",
  "license": "MIT",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "exports": {
    ".": {
      "default": "./lib/index.mjs"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node test/run-all.mjs",
    "verify": "node lib/server.mjs --open"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "nutstore",
    "jianguoyun",
    "webdav",
    "backup",
    "restore",
    "sync"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  }
}
